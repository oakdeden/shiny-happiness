{
  "name": "vanilla-basic",
  "version": "1.0.0",
  "scripts": {
    "start": "webpack serve",
    "build": "webpack build --mode=production",
    "watch": "webpack build --watch",
    "lint:css": "stylelint \"src/**/*.{scss,css}\"",
    "lint:css:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "format": "prettier --write \"src/**/*.{html,scss,css,js}\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{html,scss,css,js}\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "test": "npm run lint:css && npm run format:check && npm run build",
    "recipe-generator": "node src/js/server.js",
    "feedback-server": "node tmp/feedback/bin/www",
    "body-server": "npm --prefix tmp/body start",
    "wyr-server": "PORT=3001 node tmp/wyr/server.js",
    "express-apps": "npm run feedback-server & npm run body-server & npm run wyr-server & wait",
    "site": "node server.js",
    "site:local": "npm run build && node server.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@popperjs/core": "^2.11.8",
    "autoprefixer": "^10.5.5",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cookie-parser": "~1.4.4",
    "css-loader": "^7.1.5",
    "express": "~4.16.1",
    "express-handlebars": "^7.1.3",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "mysql2": "^3.24.6",
    "postcss-loader": "^8.2.1",
    "sass": "^1.104.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "webpack-dev-server": "^5.2.6"
  }
}
