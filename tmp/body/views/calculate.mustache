{{> header}}
<main class="app-container">
  <div class="card">
    <header class="card-header">
      <div class="badge">Calculation Result</div>
      <h1>Body Mass Index Result</h1>
      <p class="subtitle">Your BMI has been calculated based on your height and weight.</p>
    </header>
    <section class="results-card result-{{categoryClass}}">
      <div class="results-header">
        <span class="result-kicker">Calculated BMI</span>
        <div class="bmi-display"><span class="bmi-number">{{bmi}}</span><span class="bmi-label">kg/m²</span></div>
        {{#category}}<div class="category-badge badge-{{categoryClass}}">{{category}}</div>{{/category}}
      </div>
      <p class="result-text">Your calculated Body Mass Index is <strong class="bmi-highlight">{{bmi}}</strong>.</p>
      {{#description}}<p class="result-description">{{description}}</p>{{/description}}
      <div class="details-summary">
        <div class="detail-item"><span class="detail-label">Height</span><strong class="detail-value">{{height}} m</strong></div>
        <div class="detail-item"><span class="detail-label">Weight</span><strong class="detail-value">{{weight}} kg</strong></div>
        <div class="detail-item"><span class="detail-label">Calculated BMI</span><strong class="detail-value">{{bmi}}</strong></div>
      </div>
      <div class="bmi-scale">
        <div class="scale-header"><span>BMI Categories (WHO Standard)</span></div>
        <div class="scale-bar">
          <div class="scale-segment segment-underweight {{#isUnderweight}}active{{/isUnderweight}}"><span class="segment-label">&lt; 18.5</span><span class="segment-name">Underweight</span></div>
          <div class="scale-segment segment-normal {{#isNormal}}active{{/isNormal}}"><span class="segment-label">18.5 – 24.9</span><span class="segment-name">Normal</span></div>
          <div class="scale-segment segment-overweight {{#isOverweight}}active{{/isOverweight}}"><span class="segment-label">25.0 – 29.9</span><span class="segment-name">Overweight</span></div>
          <div class="scale-segment segment-obese {{#isObese}}active{{/isObese}}"><span class="segment-label">&ge; 30.0</span><span class="segment-name">Obese</span></div>
        </div>
      </div>
      <div class="form-actions">
        <a class="btn btn-primary" href="/">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Calculate Again</span>
        </a>
      </div>
    </section>
    <footer class="card-footer"><p>Standard formula: <code>BMI = weight (kg) / [height (m)]²</code></p></footer>
  </div>
</main>
{{> footer}}
