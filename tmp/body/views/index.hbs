<main class='app-container'>
  <div class='card'>
    <header class='card-header'>
      <div class='badge'>Health &amp; Wellness</div>
      <h1>Body Mass Index (BMI) Calculator</h1>
      <p class='subtitle'>Calculate your Body Mass Index quickly and accurately using height in
        meters and weight in kilograms.</p>
    </header>

    {{#if error}}
      <div class='alert alert-error' role='alert'>
        <div class='alert-icon'>
          <svg
            viewBox='0 0 24 24'
            width='22'
            height='22'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
          >
            <circle cx='12' cy='12' r='10'></circle>
            <line x1='12' y1='8' x2='12' y2='12'></line>
            <line x1='12' y1='16' x2='12.01' y2='16'></line>
          </svg>
        </div>
        <div class='alert-content'>
          <strong class='alert-title'>Calculation Error</strong>
          <p class='alert-message'>{{error}}</p>
        </div>
      </div>
    {{/if}}

    <form class='bmi-form' action='/body-index/calculate' method='GET'>
      <div class='form-group'>
        <label for='height'>
          <span class='label-title'>Height</span>
          <span class='label-unit'>in meters (m)</span>
        </label>
        <div class='input-wrapper'>
          <input
            id='height'
            type='number'
            name='height'
            step='any'
            min='0'
            placeholder='e.g. 1.75'
            value='{{height}}'
          />
          <span class='input-suffix'>m</span>
        </div>
        <small class='input-hint'>Enter decimal value (e.g. 1.75 m)</small>
      </div>

      <div class='form-group'>
        <label for='weight'>
          <span class='label-title'>Weight</span>
          <span class='label-unit'>in kilograms (kg)</span>
        </label>
        <div class='input-wrapper'>
          <input
            id='weight'
            type='number'
            name='weight'
            step='any'
            min='0'
            placeholder='e.g. 68.5'
            value='{{weight}}'
          />
          <span class='input-suffix'>kg</span>
        </div>
        <small class='input-hint'>Enter decimal value (e.g. 68.5 kg)</small>
      </div>

      <div class='form-actions'>
        <button id='calculate-btn' class='btn btn-primary' type='submit'>
          <span>Calculate</span>
          <svg
            viewBox='0 0 24 24'
            width='18'
            height='18'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
          >
            <line x1='5' y1='12' x2='19' y2='12'></line>
            <polyline points='12 5 19 12 12 19'></polyline>
          </svg>
        </button>
        {{#showReset}}<a class='btn btn-secondary' href='/body-index/'>Reset</a>{{/showReset}}
      </div>
    </form>

    <footer class='card-footer'>
      <p>Standard formula: <code>BMI = weight (kg) / [height (m)]²</code></p>
    </footer>
  </div>
</main>