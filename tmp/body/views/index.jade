extends layout

block content
  main.app-container
    .card
      header.card-header
        .badge Health &amp; Wellness
        h1 Body Mass Index (BMI) Calculator
        p.subtitle Calculate your Body Mass Index quickly and accurately using height in meters and weight in kilograms.

      if error
        .alert.alert-error(role="alert")
          .alert-icon
            svg(viewBox="0 0 24 24", width="22", height="22", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
              circle(cx="12", cy="12", r="10")
              line(x1="12", y1="8", x2="12", y2="12")
              line(x1="12", y1="16", x2="12.01", y2="16")
          .alert-content
            strong.alert-title Calculation Error
            p.alert-message= error

      form.bmi-form(action="/calculate", method="GET")
        .form-group
          label(for="height")
            span.label-title Height
            span.label-unit in meters (m)
          .input-wrapper
            input#height(
              type="number",
              name="height",
              step="any",
              min="0",
              placeholder="e.g. 1.75",
              value=height || ''
            )
            span.input-suffix m
          small.input-hint Enter decimal value (e.g. 1.75 m)

        .form-group
          label(for="weight")
            span.label-title Weight
            span.label-unit in kilograms (kg)
          .input-wrapper
            input#weight(
              type="number",
              name="weight",
              step="any",
              min="0",
              placeholder="e.g. 68.5",
              value=weight || ''
            )
            span.input-suffix kg
          small.input-hint Enter decimal value (e.g. 68.5 kg)

        .form-actions
          button#calculate-btn.btn.btn-primary(type="submit")
            span Calculate
            svg(viewBox="0 0 24 24", width="18", height="18", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
              line(x1="5", y1="12", x2="19", y2="12")
              polyline(points="12 5 19 12 12 19")
          if bmi || error
            a.btn.btn-secondary(href="/") Reset

      if bmi
        section.results-card(class="result-" + categoryClass)
          .results-header
            span.result-kicker Your Calculated BMI
            .bmi-display
              span.bmi-number= bmi
              span.bmi-label kg/m²
            .category-badge(class="badge-" + categoryClass)= category

          p.result-description= description

          .bmi-scale
            .scale-header
              span BMI Categories (WHO Standard)
            .scale-bar
              .scale-segment.segment-underweight(class=categoryClass === 'underweight' ? 'active' : '')
                span.segment-label &lt; 18.5
                span.segment-name Underweight
              .scale-segment.segment-normal(class=categoryClass === 'normal' ? 'active' : '')
                span.segment-label 18.5 – 24.9
                span.segment-name Normal
              .scale-segment.segment-overweight(class=categoryClass === 'overweight' ? 'active' : '')
                span.segment-label 25.0 – 29.9
                span.segment-name Overweight
              .scale-segment.segment-obese(class=categoryClass === 'obese' ? 'active' : '')
                span.segment-label &ge; 30.0
                span.segment-name Obese

      footer.card-footer
        p Standard formula: 
          code BMI = weight (kg) / [height (m)]²
