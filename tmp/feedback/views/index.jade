extends layout

block content
  main.page-shell
    section.form-panel(aria-labelledby='page-title')
      .brand-mark ITEC
      if submitted
        .success-state(role='status')
          .success-icon(aria-hidden='true') ✓
          p.eyebrow RESPONSE RECEIVED
          h1#page-title Thank you for your feedback.
          p Your response has been recorded for this session.
          a.button-link(href='/') Submit another response
      else
        p.eyebrow STUDENT SERVICES
        h1#page-title Student Feedback
        p.intro Share your thoughts with us. All fields are required.

        if errors.length
          .error-summary(role='alert' aria-live='polite')
            p Please review the following:
            ul
              each error in errors
                li= error

        form.feedback-form(action='/' method='POST')
          .field
            label(for='name') Name
            input#name(type='text' name='name' value=name maxlength='100' autocomplete='name' required)

          .field
            label(for='email') Email
            input#email(type='email' name='email' value=email maxlength='254' autocomplete='email' required)

          fieldset.fieldset
            legend Are you a current student?
            .choice-list
              label.choice-option(for='student-yes')
                if studentStatus === 'yes'
                  input#student-yes(type='radio' name='studentStatus' value='yes' checked required)
                else
                  input#student-yes(type='radio' name='studentStatus' value='yes' required)
                span Yes
              label.choice-option(for='student-no')
                if studentStatus === 'no'
                  input#student-no(type='radio' name='studentStatus' value='no' checked required)
                else
                  input#student-no(type='radio' name='studentStatus' value='no' required)
                span No

          .field
            label(for='comments') Comments
            textarea#comments(name='comments' rows='6' maxlength='5000' required)= comments
            p.field-hint Maximum 5000 characters.

          button.submit-button(type='submit') Send feedback
